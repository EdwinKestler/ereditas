# Copy to .env and fill locally. Never commit .env.
# Meta Model API (OpenAI-compatible). Either name works.
META_API_KEY=
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image-1.0

# Optional: Hugging Face (open-weight Muse Spark Open / Glimmer)
HF_TOKEN=

# Optional: Modal (open-weight inference)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Demo only. Leave empty in production.
EREDITAS_DEMO_MODE=1
