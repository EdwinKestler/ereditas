    "*.json",
    "*.yaml",
    "*.yml",
    "docs/**/*.md",
    "docs/**/*.txt",
    "ideas/**/*.md",
    "ideas/**/*.json",
    "scripts/**/*.sh",
    "scripts/**/*.py",
    "src/**/*.py",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.rs",
    "app/**/*.py",
    "app/**/*.ts",
    "app/**/*.tsx",
    "apps/**/*.md",
    "apps/**/*.py",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/**/*.js",
    "apps/**/*.json",
    ".agents/skills/**/*.md",
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml"
  ],
  "exclude_directories": [
    ".palimnex",
    ".ecc",
    ".venv",
    "node_modules",
    "dist",
    "build",
    "vendor"
  ],
  "semantic_provider": {
    "mode": "disabled"
