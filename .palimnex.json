{
  "project_slug": "ereditas",
  "project_id": "4999764e-2d09-4fd4-b30d-1c20e318e2fa",
  "cache_mode": "on",
  "redis_socket_path": ".palimnex/redis/redis.sock",
  "durable_ledger_path": ".palimnex/memory.sqlite3",
